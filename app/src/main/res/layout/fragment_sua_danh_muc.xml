<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFF6F1"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- HEADER -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="@drawable/bg_header_sua_dm"
            android:gravity="center_vertical"
            android:paddingHorizontal="20dp"
            android:paddingTop="22dp"
            android:paddingBottom="26dp">

            <!-- BACK -->
            <ImageView
                android:id="@+id/btnBack_themdm"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginEnd="16dp"
                android:src="@drawable/ic_muiten"
               />

            <!-- TITLE -->
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Sửa danh mục"
                android:textColor="#FFFFFF"
                android:textSize="24sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- FORM -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="-14dp"
            android:background="@drawable/bg_card_sua_dm"
            android:elevation="3dp"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- ── ten ── -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"
                android:text="Tên danh mục *"
                android:textColor="#333333"
                android:textSize="13sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/edtSuaTenDanhMuc"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginBottom="16dp"
                android:background="@drawable/bg_input_cam"
                android:hint="Nhập tên danh mục"
                android:inputType="textCapWords"
                android:paddingHorizontal="14dp"
                android:textColor="#111111"
                android:textColorHint="#AAAAAA"
                android:textSize="14sp" />

            <!-- ── mo_ta ── -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"
                android:text="Mô tả"
                android:textColor="#333333"
                android:textSize="13sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/edtSuaMoTa"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginBottom="16dp"
                android:background="@drawable/bg_input_cam"
                android:hint="Mô tả danh mục (tuỳ chọn)"
                android:paddingHorizontal="14dp"
                android:textColor="#111111"
                android:textColorHint="#AAAAAA"
                android:textSize="14sp" />

            <!-- ── icon ── -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"
                android:text="Tên icon"
                android:textColor="#333333"
                android:textSize="13sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/edtIconSua"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginBottom="6dp"
                android:background="@drawable/bg_input_cam"
                android:hint="Tên icon (vd: ic_luxury)"
                android:inputType="text"
                android:paddingHorizontal="14dp"
                android:textColor="#111111"
                android:textColorHint="#AAAAAA"
                android:textSize="14sp" />

            <!-- Hint -->
            <TextView
                android:id="@+id/tvHinhIcon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="28dp"
                android:text="Bỏ trống → dùng icon mặc định"
                android:textColor="#B0B0B0"
                android:textSize="11sp" />

            <!-- BUTTON -->
            <Button
                android:id="@+id/btnSuaDanhMuc"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:background="@drawable/bg_button_cam_full"
                android:text="Sửa danh mục"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>